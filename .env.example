# Postgres (used by docker-compose.yml)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm

# Used by `npm run dev` / Prisma CLI when Postgres is reached via
# docker-compose's published port (localhost:5432). The `app` service in
# docker-compose.yml builds its own DATABASE_URL from the POSTGRES_* vars
# above and does not read this one directly.
DATABASE_URL=postgresql://crm:change-me@localhost:5432/crm

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Seeded admin account (see prisma/seed.ts)
ADMIN_USERNAME=arthur
ADMIN_PASSWORD=change-me

# «Кабинет ученика» (github.com/Artdwan/kabinet) — optional, read-only.
# Without these the CRM works normally; students just can't be linked to
# their Кабинет accounts from a picker (the id can still be typed in).
# Get a token: POST {KABINET_API_URL}/auth/login with a teacher's
# {email, password} and copy the returned `token`.
KABINET_API_URL=http://localhost:4000/api
KABINET_TOKEN=
