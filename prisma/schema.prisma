generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

enum LeadStatus {
  NEW
  IN_DIALOG
  QUALIFICATION
  DIAGNOSTIC
  DECISION
  RESULT
}

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  who       String
  grade     String
  subject   String
  channel   String
  status    LeadStatus @default(NEW)
  sub       String
  task      String?
  client    Client?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Client {
  id            Int            @id @default(autoincrement())
  name          String
  who           String
  grade         String
  subject       String
  channel       String
  phone         String?
  fromLead      Lead?          @relation(fields: [fromLeadId], references: [id])
  fromLeadId    Int?           @unique
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
}

model Subscription {
  id              Int      @id @default(autoincrement())
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId        Int
  subject         String
  periodStart     DateTime
  lessonsCount    Int
  pricePerLesson  Decimal  @db.Decimal(10, 2)
  discountPercent Decimal  @db.Decimal(5, 2) @default(0)
  createdAt       DateTime @default(now())

  @@unique([clientId, subject, periodStart])
}
