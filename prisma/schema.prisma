generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

enum LeadStatus {
  NEW
  IN_DIALOG
  QUALIFICATION
  DIAGNOSTIC
  DECISION
  RESULT
}

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  who       String
  grade     String
  subject   String
  channel   String
  status    LeadStatus @default(NEW)
  sub       String
  task      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
